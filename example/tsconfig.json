{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "lib": [
      "dom",
      "esnext"
    ],
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "src/App.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/data/**/*.ts",
    "src/data/**/*.tsx",
    "src/screens/**/*.ts",
    "src/screens/**/*.tsx",
    "src/tests/DefaultStack.tsx"
  ]
}
